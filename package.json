{
  "name": "uxcalibur",
  "version": "0.1.7",
  "description": "Expert UX review, design direction, and implementation guidance for your coding agent",
  "homepage": "https://uxcalibur.dev",
  "repository": { "type": "git", "url": "git+https://github.com/Catalyst-Forge-LLC/uxcalibur.git" },
  "bugs": { "url": "https://github.com/Catalyst-Forge-LLC/uxcalibur/issues" },
  "keywords": ["agent-skills", "skills", "codex", "claude-code", "cursor", "grok", "xai", "ux", "design", "accessibility"],
  "bin": { "uxcalibur": "dist/bin/uxcalibur.js" },
  "files": ["dist/bin/", "dist/lib/", "dist/skill/", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:e2e:install": "node scripts/install-browser.mjs",
    "verify": "pnpm skill:copy && pnpm check && pnpm build && pnpm test && pnpm proof:baseline",
    "skill:check": "node scripts/check-skill.mjs",
    "skill:copy": "node scripts/check-skill.mjs --copy",
    "status": "node scripts/status.mjs",
    "proof:baseline": "node scripts/prove-baseline.mjs",
    "package:build": "node scripts/build-package.mjs",
    "package:check": "node scripts/check-package.mjs",
    "prepack": "node scripts/build-package.mjs",
    "site:check": "pnpm --dir site check && pnpm --dir site build",
    "verify:release": "pnpm verify && pnpm package:check && pnpm site:check",
    "ship": "pnpm --dir site run ship",
    "deploy:site": "node node_modules/wrangler/bin/wrangler.js pages deploy site/build --project-name uxcalibur-dev --branch main"
  },
  "author": "Catalyst Forge, LLC",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "wrangler": "4.147.0",
    "yaml": "2.9.1"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  }
}
