{
  "name": "uxcalibur",
  "version": "0.1.0-dev",
  "description": "UXcalibur versioned skill and private developer-proof harness",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e:install": "node scripts/install-browser.mjs",
    "verify": "pnpm skill:check && pnpm check && pnpm build && pnpm test",
    "skill:check": "node scripts/check-skill.mjs",
    "skill:copy": "node scripts/check-skill.mjs --copy"
  },
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "yaml": "2.9.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
