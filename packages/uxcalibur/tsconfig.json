{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "../../.artifacts/npm-package",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
